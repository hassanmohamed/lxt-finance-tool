# ─────────────────────────────────────────────────────────────
# Streamlit App Secrets — TEMPLATE
#
#   cp secrets.toml.example .streamlit/secrets.toml
#
# Then fill in every value below. See docs/SETUP.md for what each
# key means and where to obtain it.
#
# .streamlit/secrets.toml is gitignored. NEVER commit real values.
#
# NOTE: this file is also written to at runtime. QuickBooks refresh
# tokens are single-use, so the app rewrites each [companies.*]
# refresh_token in place after every run. Keep the file writable, and
# don't hand-edit it while a report is generating.
# ─────────────────────────────────────────────────────────────

# ── App login ────────────────────────────────────────────────
# APP_PASSWORD_HASH is a bcrypt hash, not the plaintext password. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
APP_USERNAME      = "finance@example.com"
APP_PASSWORD_HASH = "$2b$12$replace_with_a_real_bcrypt_hash"

# ── Google Gemini (optional) ─────────────────────────────────
# Enables the AI Financial Assistant. Leave empty to disable it; everything
# else works normally. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY = ""

# ── QuickBooks OAuth 2.0 (one Intuit app, all 9 companies) ───
QB_CLIENT_ID     = ""
QB_CLIENT_SECRET = ""

# ── Company credentials ──────────────────────────────────────
# `label` MUST exactly match a key in COMPANY_CURRENCY (app.py:576), or that
# company's rows get a blank currency and a forex rate of 1.0 — silently.
#
# Current valid labels and their currencies:
#   LXT Egypt EGP · LXT Canada CAD · LXT Australia AUD · LXT Romania RON
#   LXT India INR · CW GmbH EUR · LXT UK GBP · LXT USA USD · CW Inc USD

[companies.lxt_egypt]
label         = "LXT Egypt"
realm_id      = ""
refresh_token = ""

[companies.lxt_canada]
label         = "LXT Canada"
realm_id      = ""
refresh_token = ""

[companies.lxt_australia]
label         = "LXT Australia"
realm_id      = ""
refresh_token = ""

[companies.lxt_romania]
label         = "LXT Romania"
realm_id      = ""
refresh_token = ""

[companies.lxt_india]
label         = "LXT India"
realm_id      = ""
refresh_token = ""

[companies.lxt_germany]
label         = "CW GmbH"
realm_id      = ""
refresh_token = ""

[companies.lxt_uk]
label         = "LXT UK"
realm_id      = ""
refresh_token = ""

[companies.lxt_usa]
label         = "LXT USA"
realm_id      = ""
refresh_token = ""

[companies.lxt_clickworker_usa]
label         = "CW Inc"
realm_id      = ""
refresh_token = ""
